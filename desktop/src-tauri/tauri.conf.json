{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "photolib",
  "version": "2.0.2",
  "identifier": "dev.photolib.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/photolib-server"],
    "resources": {
      "binaries/_internal/": "_internal/"
    },
    "shortDescription": "A local, private photo library",
    "longDescription": "Search your photos by describing them, and by face. Everything runs on your own machine.",
    "copyright": "",
    "category": "Photography"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
